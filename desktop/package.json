{
  "name": "mcn-ai-desktop",
  "version": "0.1.1",
  "description": "mcn-ai 桌面版：MCN 公司与达人的 AI 工作操作系统",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac && node scripts/fix-latest-yml.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke:agent": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron out/main/smoke-agent.js",
    "smoke:provider": "electron-vite build && electron out/main/smoke-provider.js",
    "smoke:resume": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron out/main/smoke-resume.js",
    "smoke:steps": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron out/main/smoke-steps.js",
    "smoke:cards": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron out/main/smoke-cards.js",
    "smoke:write": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron out/main/smoke-write-guard.js",
    "smoke:taxonomy": "electron-vite build && ELECTRON_RUN_AS_NODE=1 electron out/main/smoke-taxonomy.js",
    "smoke:ipc": "node scripts/smoke-ipc-contract.mjs",
    "smoke:pipeline": "node scripts/smoke-pipeline.mjs",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.211",
    "@supabase/supabase-js": "^2.45.0",
    "chokidar": "^3.6.0",
    "dompurify": "^3.4.12",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "minisearch": "^7.1.0",
    "p-queue": "^8.0.1",
    "react-force-graph-2d": "^1.29.1",
    "remark-wiki-link": "^2.0.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^43.4.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
